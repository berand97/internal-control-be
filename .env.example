NODE_ENV=development
PORT=3000

# Con docker-compose.dev.yml: postgres://asset_admin:secret@localhost:5432/asset_management
DATABASE_URL=
DATABASE_LOGGING=false
# Fuera de NODE_ENV=production el backend y el CLI de migraciones solo se conectan a hosts
# locales (localhost, 127.0.0.0/8, ::1 o el contenedor "postgres" de docker-compose.dev.yml).
# Para apuntar a otro host a propósito (queda un aviso en el log) declare:
# ALLOW_REMOTE_DATABASE=true

JWT_ACCESS_SECRET=reemplazar-por-openssl-rand-base64-64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=reemplazar-por-openssl-rand-base64-64
JWT_REFRESH_EXPIRES_IN=7d
JWT_MFA_CHALLENGE_EXPIRES_IN=5m
JWT_ISSUER=asset-management-api
JWT_AUDIENCE=asset-management-web
# Una clave por propósito (obligatorias en producción, distintas de JWT_*). Ver docs/DEPLOY.md §7.
QR_SIGNING_SECRET=reemplazar-por-openssl-rand-base64-64

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

REFRESH_COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_PUBLIC_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:3000

MOVEMENT_SIGNING_SECRET=reemplazar-por-openssl-rand-base64-64
SETTINGS_ENCRYPTION_KEY=reemplazar-por-openssl-rand-base64-32
# Solo durante una rotación (lista separada por comas): la anterior sigue verificando / descifrando.
# MOVEMENT_SIGNING_SECRET_PREVIOUS=
# SETTINGS_ENCRYPTION_KEY_PREVIOUS=

# Identidad de los correos (encabezado y pie comunes a todas las plantillas de correo).
# MAIL_BRAND_LOGO_URL: URL https de una imagen PNG o JPG del logo, publicada donde los clientes de correo la
# puedan descargar (Gmail y Outlook no muestran SVG ni imágenes de localhost). Vacía: el encabezado muestra
# MAIL_BRAND_NAME como texto.
# MAIL_BRAND_NAME=Control Interno UNAC
# MAIL_BRAND_LOGO_URL=

# Calendario de tomas físicas: alerta de concentración cuando una semana ISO tiene MÁS tomas que este número (entero
# >= 1). Vacía: no se evalúa (Control Interno aún no definió el número).
# INVENTORY_WEEKLY_CONCENTRATION_THRESHOLD=

# Destinos salientes que configura un administrador (host SMTP, endpoint S3). Fuera de producción se
# permiten redes privadas (MailHog/MinIO en localhost); en producción no, salvo esta lista de hosts o IP.
# OUTBOUND_ALLOW_PRIVATE_NETWORKS=true
# OUTBOUND_ALLOWED_HOSTS=minio,relay.interno.unac.edu.co

STORAGE_DRIVER=project
STORAGE_PROJECT_PATH=storage

STORAGE_S3_PROVIDER=minio
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=control-interno
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
# Imágenes de las plantillas de correo (docs/DEPLOY.md §10.7): se guardan en images/email/<uuid>.png|jpg del bucket
# indicado aquí, en el mismo proveedor S3, y su URL pública base (https en producción; se valida al arrancar). Puede
# ser el MISMO bucket de documentos (p. ej. control-interno-dev) si su política anónima permite SOLO s3:GetObject en
# images/email/* (nunca el bucket completo); en producción se recomienda un bucket aparte. Ejemplo mismo bucket:
#   STORAGE_S3_PUBLIC_ASSETS_BUCKET=control-interno-dev
#   STORAGE_S3_PUBLIC_ASSETS_BASE_URL=https://minio-api.dominio/control-interno-dev
# Sin ellos no se pueden subir imágenes (409 PUBLIC_ASSETS_NOT_CONFIGURED). La pantalla Almacenamiento manda sobre
# estos valores.
STORAGE_S3_PUBLIC_ASSETS_BUCKET=
STORAGE_S3_PUBLIC_ASSETS_BASE_URL=

STORAGE_GOOGLE_CLIENT_ID=
STORAGE_GOOGLE_CLIENT_SECRET=
STORAGE_GOOGLE_REFRESH_TOKEN=
STORAGE_GOOGLE_FOLDER_ID=

STORAGE_ONEDRIVE_TENANT_ID=common
STORAGE_ONEDRIVE_CLIENT_ID=
STORAGE_ONEDRIVE_CLIENT_SECRET=
STORAGE_ONEDRIVE_REFRESH_TOKEN=
STORAGE_ONEDRIVE_FOLDER_ID=

# Feature flags: FEATURE_<CODE>=false apaga el módulo (guiones → guiones bajos).
# Ej: FEATURE_LOANS=false  FEATURE_QR_TOKENS=false
# Los módulos core (auth, roles, users, features) no se apagan.
# Circuito: FEATURE_CIRCUIT_THRESHOLD errores internos (5xx) dentro de FEATURE_CIRCUIT_WINDOW_SECONDS apagan el
# módulo (motivo CIRCUIT). Tras FEATURE_CIRCUIT_COOLDOWN_SECONDS se deja pasar una petición de prueba: si responde
# bien se reactiva solo; si falla, la espera vuelve a empezar.
FEATURE_CIRCUIT_THRESHOLD=5
FEATURE_CIRCUIT_WINDOW_SECONDS=120
FEATURE_CIRCUIT_COOLDOWN_SECONDS=300
# Relectura completa de feature_flag desde la BD (además del NOTIFY del trigger). 0 = solo NOTIFY.
FEATURE_FLAGS_RELOAD_SECONDS=30

# OpenObserve (OTLP HTTP). El Authorization es "Basic <base64>".
OTEL_SERVICE_NAME=control-interno-be
OTEL_EXPORTER_OTLP_ENDPOINT=http://host:5080/api/default
OTEL_EXPORTER_OTLP_AUTH=Basic reemplazar
OTEL_STREAM_NAME=default
OTEL_ORGANIZATION=default

# NestJS Observe cloud (opcional; si falta, no se registra)
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# Motor de documentos: Gotenberg convierte las actas DOCX a PDF.
# Obligatoria en producción (sin ella la aplicación no arranca). En desarrollo es opcional,
# pero sin ella toda conversión a PDF falla: docker compose -f docker-compose.dev.yml up -d gotenberg
GOTENBERG_URL=http://localhost:3100
# continue | restart
DOCUMENT_NUMBERING_POLICY=continue
# internal (firma electrónica simple con rúbrica) | stub (solo desarrollo)
SIGNATURE_PROVIDER=internal
# URL pública del frontend que recibe el código del QR de verificación. Queda impresa en cada acta firmada.
# Obligatoria en producción (https y pública): sin ella la aplicación no arranca.
SIGNATURE_VERIFY_URL=http://localhost:4200/verificar-firma

# Documentación de la API (/api/openapi.json y /api/reference). Por defecto apagada si NODE_ENV=production
# API_DOCS_ENABLED=false

# Proxies en los que se confía para leer X-Forwarded-For (IP real del cliente: firmas, auditoría, throttler).
# Por defecto solo proxies en red privada (Traefik de Dokploy en la red de Docker).
# Número de saltos (ej. 2 con Cloudflare delante) o lista de redes. Nunca "true".
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Peticiones por usuario autenticado, por ruta, en 60 s (sin sesión: 100 por IP). Entero >= 1.
# THROTTLE_USER_LIMIT=300

# Eventos en tiempo real (SSE, GET /api/v1/events). Ver docs/DEPLOY.md §11.
# Streams abiertos a la vez en esta instancia (1..100000); el siguiente recibe 503.
# EVENTS_MAX_STREAMS=500
# Latido ": ping" y revalidación de sesión, en ms (100..55000). Menor que el timeout de inactividad del proxy.
# EVENTS_HEARTBEAT_MS=25000
# Vida del ticket de un solo uso de POST /api/v1/events/ticket, en segundos (1..30).
# EVENTS_TICKET_TTL_SECONDS=30
