NODE_ENV=development
PORT=3000

DATABASE_URL=
DATABASE_LOGGING=false

JWT_ACCESS_SECRET=reemplazar-por-openssl-rand-base64-64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=reemplazar-por-openssl-rand-base64-64
JWT_REFRESH_EXPIRES_IN=7d
JWT_MFA_CHALLENGE_EXPIRES_IN=5m
JWT_ISSUER=asset-management-api
JWT_AUDIENCE=asset-management-web
QR_SIGNING_SECRET=reemplazar-por-openssl-rand-base64-64

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

REFRESH_COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:4200
APP_PUBLIC_URL=http://localhost:4200
API_PUBLIC_URL=http://localhost:3000

MOVEMENT_SIGNING_SECRET=reemplazar-por-openssl-rand-base64-64
SETTINGS_ENCRYPTION_KEY=reemplazar-por-openssl-rand-base64-32

STORAGE_DRIVER=project
STORAGE_PROJECT_PATH=storage

STORAGE_S3_PROVIDER=minio
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=control-interno
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

STORAGE_GOOGLE_CLIENT_ID=
STORAGE_GOOGLE_CLIENT_SECRET=
STORAGE_GOOGLE_REFRESH_TOKEN=
STORAGE_GOOGLE_FOLDER_ID=

STORAGE_ONEDRIVE_TENANT_ID=common
STORAGE_ONEDRIVE_CLIENT_ID=
STORAGE_ONEDRIVE_CLIENT_SECRET=
STORAGE_ONEDRIVE_REFRESH_TOKEN=
STORAGE_ONEDRIVE_FOLDER_ID=

# Feature flags: FEATURE_<CODE>=false apaga el módulo (guiones → guiones bajos).
# Ej: FEATURE_LOANS=false  FEATURE_QR_TOKENS=false
# Los módulos core (auth, roles, users, features) no se apagan.
FEATURE_CIRCUIT_THRESHOLD=5

# OpenObserve (OTLP HTTP). El Authorization es "Basic <base64>".
OTEL_SERVICE_NAME=control-interno-be
OTEL_EXPORTER_OTLP_ENDPOINT=http://host:5080/api/default
OTEL_EXPORTER_OTLP_AUTH=Basic reemplazar
OTEL_STREAM_NAME=default
OTEL_ORGANIZATION=default

# NestJS Observe cloud (opcional; si falta, no se registra)
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# Motor de documentos
GOTENBERG_URL=http://localhost:3100
# continue | restart
DOCUMENT_NUMBERING_POLICY=continue
# internal (firma electrónica simple con rúbrica) | stub (solo desarrollo)
SIGNATURE_PROVIDER=internal
# URL pública del frontend que recibe el código del QR de verificación. Queda impresa en cada acta firmada.
# Obligatoria en producción (https y pública): sin ella la aplicación no arranca.
SIGNATURE_VERIFY_URL=http://localhost:4200/verificar-firma

# Documentación de la API (/api/openapi.json y /api/reference). Por defecto apagada si NODE_ENV=production
# API_DOCS_ENABLED=false

# Proxies en los que se confía para leer X-Forwarded-For (IP real del cliente: firmas, auditoría, throttler).
# Por defecto solo proxies en red privada (Traefik de Dokploy en la red de Docker).
# Número de saltos (ej. 2 con Cloudflare delante) o lista de redes. Nunca "true".
# TRUST_PROXY=loopback, linklocal, uniquelocal
