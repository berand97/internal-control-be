meta {
  name: create sod rule
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/roles/sod-rules
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "roleAId": "{{roleId}}",
    "roleBId": "{{roleBId}}",
    "constraintType": "STATIC",
    "reason": "Roles mutuamente excluyentes de control interno"
  }
}
