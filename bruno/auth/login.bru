meta {
  name: login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

docs {
  Username o correo @unac.edu.co. Puede devolver accessToken, requiresMfa o requiresMfaSetup.
}
